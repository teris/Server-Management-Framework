{
  "id": "shop.communications",
  "version": "1.0.0",
  "name": "Mail und Benachrichtigungen",
  "core": ">=3.3.0 <4.0.0",
  "php": ">=8.3.0",
  "requires": {
    "shop.portal": "^1.0.0"
  },
  "routes": {
