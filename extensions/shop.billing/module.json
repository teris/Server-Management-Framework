{
  "id": "shop.billing",
  "version": "1.0.0",
  "name": "Rechnungen und PDF",
  "core": ">=3.3.0 <4.0.0",
  "php": ">=8.3.0",
  "requires": {
    "shop.orders": "^1.0.0"
