{
  "id": "shop.provisioning",
  "version": "1.1.0",
  "name": "Bereitstellung und Ressourcen",
  "core": ">=3.3.0 <4.0.0",
  "php": ">=8.3.0",
  "requires": {
    "shop.orders": "^1.0.0"
  },
  "routes": {
    "/konto/verwalten": "manage_resource",
    "/admin/schnittstellen": "admin_integrations",
    "/admin/automatisierung": "admin_automation",
    "/admin/ressourcen": "admin_resources",
    "/admin/domains": "admin_domains"
  },
  "jobs": {
    "shop.provisioning": {
      "handler": "shop.provisioning",
      "safe_replay": false
    }
  },
  "permissions": [
    "backend:admin",
    "customer:owner"
  ],
  "migrations": []
}
