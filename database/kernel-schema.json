{
  "version": "20261024_modular_01",
  "tables": {
    "smf_module_state": {
      "columns": {
        "module_id": "VARCHAR(80) PRIMARY KEY",
        "installed_version": "VARCHAR(32) NOT NULL",
        "manifest_hash": "VARCHAR(64) NOT NULL",
        "enabled": "INTEGER NOT NULL DEFAULT 0"
      },
      "constraints": [],
      "indexes": {}
    },
    "smf_module_migrations": {
      "columns": {
        "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
        "module_id": "VARCHAR(80) NOT NULL",
        "migration": "VARCHAR(180) NOT NULL",
        "checksum": "VARCHAR(64) NOT NULL",
        "applied_at": "BIGINT NOT NULL"
      },
      "constraints": [
        "UNIQUE(module_id,migration)"
      ],
      "indexes": {}
    },
    "smf_audit": {
      "columns": {
        "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
        "occurred_at": "BIGINT NOT NULL",
        "request_id": "VARCHAR(32) NOT NULL",
        "job_id": "VARCHAR(64)",
        "actor_realm": "VARCHAR(20) NOT NULL",
        "actor_id": "INTEGER",
        "event": "VARCHAR(120) NOT NULL",
        "subject": "VARCHAR(180)",
        "result": "VARCHAR(32) NOT NULL",
        "context": "TEXT NOT NULL"
      },
      "constraints": [],
      "indexes": {
        "idx_smf_audit_time": [
          "occurred_at"
        ]
      }
    },
    "smf_jobs": {
      "columns": {
        "id": "VARCHAR(32) PRIMARY KEY",
        "module_id": "VARCHAR(80) NOT NULL",
        "type": "VARCHAR(120) NOT NULL",
        "idempotency_key": "VARCHAR(180) NOT NULL UNIQUE",
        "payload": "TEXT NOT NULL",
        "state": "VARCHAR(32) NOT NULL DEFAULT 'queued'",
        "phase": "VARCHAR(80) NOT NULL DEFAULT 'start'",
        "environment": "VARCHAR(16) NOT NULL DEFAULT 'sandbox'",
        "attempts": "INTEGER NOT NULL DEFAULT 0",
        "available_at": "BIGINT NOT NULL",
        "locked_until": "BIGINT NOT NULL DEFAULT 0",
        "lock_token": "VARCHAR(64)",
        "external_id": "VARCHAR(255)",
        "last_error": "VARCHAR(80)",
        "created_at": "BIGINT NOT NULL",
        "updated_at": "BIGINT NOT NULL",
        "payload_hash": "VARCHAR(64) NOT NULL"
      },
      "constraints": [],
      "indexes": {
        "idx_smf_jobs_claim": [
          "state",
          "available_at",
          "locked_until"
        ]
      }
    },
    "smf_outbox": {
      "columns": {
        "id": "VARCHAR(32) PRIMARY KEY",
        "module_id": "VARCHAR(80) NOT NULL",
        "event_key": "VARCHAR(180) NOT NULL UNIQUE",
        "type": "VARCHAR(120) NOT NULL",
        "payload": "TEXT NOT NULL",
        "created_at": "BIGINT NOT NULL",
        "delivered_at": "BIGINT"
      },
      "constraints": [],
      "indexes": {}
    },
    "smf_migration_runs": {
      "columns": {
        "id": "VARCHAR(32) PRIMARY KEY",
        "source_digest": "VARCHAR(64) NOT NULL",
        "state": "VARCHAR(32) NOT NULL",
        "summary": "TEXT NOT NULL",
        "created_at": "BIGINT NOT NULL",
        "completed_at": "BIGINT"
      },
      "constraints": [],
      "indexes": {}
    },
    "smf_migration_ids": {
      "columns": {
        "source_digest": "VARCHAR(64) NOT NULL",
        "entity": "VARCHAR(80) NOT NULL",
        "source_id": "VARCHAR(100) NOT NULL",
        "target_id": "VARCHAR(100) NOT NULL",
        "row_hash": "VARCHAR(64) NOT NULL"
      },
      "constraints": [
        "PRIMARY KEY(source_digest,entity,source_id)"
      ],
      "indexes": {}
    },
    "smf_provider_operations": {
      "columns": {
        "id": "VARCHAR(32) PRIMARY KEY",
        "provider": "VARCHAR(32) NOT NULL",
        "connection_id": "VARCHAR(64) NOT NULL",
        "operation_key": "VARCHAR(180) NOT NULL UNIQUE",
        "request_id": "VARCHAR(32) NOT NULL",
        "state": "VARCHAR(32) NOT NULL",
        "external_id": "VARCHAR(255)",
        "created_at": "BIGINT NOT NULL",
        "updated_at": "BIGINT NOT NULL"
      },
      "constraints": [],
      "indexes": {}
    },
    "smf_core_migrations": {
      "columns": {
        "version": "VARCHAR(80) PRIMARY KEY",
        "checksum": "VARCHAR(64) NOT NULL",
        "applied_at": "BIGINT NOT NULL"
      },
      "constraints": [],
      "indexes": {}
    }
  }
}
